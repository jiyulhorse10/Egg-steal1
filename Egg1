-- [2] 계란 오브젝트 정밀 탐색 및 자동 수집 루프
local function FindAndStealEggs()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = character.HumanoidRootPart

    -- 워크스페이스 내에서 계란(Egg) 관련 모델이나 파트 탐색
    for _, obj in ipairs(workspace:GetDescendants()) do
        if not Config.Enabled then break end
        
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local primaryPart = obj:IsA("Model") and obj.PrimaryPart or obj
            if primaryPart then
                local nameLower = obj.Name:lower()
                
                -- 계란 키워드 감지
                if nameLower:find("egg") or nameLower:find("spawn") then
                    -- 거리가 너무 멀지 않거나 맵 전체의 유효한 계란인 경우 순간이동 후 상호작용
                    local dist = (rootPart.Position - primaryPart.Position).Magnitude
                    
                    if dist < 1500 then -- 너무 먼 거리를 한 번에 튀는 것 방지
                        -- 1. 계란 위치로 이동
                        rootPart.CFrame = CFrame.new(primaryPart.Position + Vector3.new(0, 3, 0))
                        
                        -- 2. 터치 프로롬프트나 프롬프트 트리거 실행
                        for _, prompt in ipairs(obj:GetDescendants()) do
                            if prompt:IsA("ProximityPrompt") then
                                fireproximityprompt(prompt)
                            end
                        end
                        
                        task.wait(0.1)
                        break
                    end
                end
            end
        end
    end
end

